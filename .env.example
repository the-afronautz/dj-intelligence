# Copy this file to .env and fill in your own values.
# .env is gitignored — never commit real keys.

# Free key: https://getsongbpm.com/api
# Registration required, plus a backlink to getsongbpm.com wherever the data
# is displayed (already present in the app footer and README).
# Without this key the catalog tool degrades to a tracklist generator plus a
# gaps CSV — it is the main tempo source, not one of several equals.
GETSONGBPM_API_KEY=

# Optional. Where the SQLite database lives. Defaults to vinyl_analyzer/data/.
# The deployed container sets this to /home/data (an Azure Files mount).
# VINYL_DATA_DIR=

# Optional. Port for the local Flask app. Defaults to 5057.
# PORT=5057
